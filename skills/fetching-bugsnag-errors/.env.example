# Bugsnag Data Access API token for the fetching-bugsnag-errors skill.
#
# Setup: copy this file to `.env` in the same directory and fill in your token.
#   cp .env.example .env && chmod 600 .env
# `.env` is gitignored — never commit your real token.
#
# Get a token: Bugsnag → Settings → My account → Personal auth tokens
BUGSNAG_AUTH_TOKEN=your-personal-auth-token-here
